{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "publicProfiles": {
      "$uid": {
        ".read": true,
        ".write": false
      }
    },
    "leaderboards": {
      ".read": true,
      ".write": false
    },
    "achievements": {
      ".read": true,
      ".write": false
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "walletTransactions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "userAchievements": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "siteSettings": {
      ".read": true,
      ".write": false
    }
  }
}
